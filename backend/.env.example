# Copy to backend/.env for running the API outside Docker. Inside docker compose these are set in docker-compose.yml.
ENV=local
DATABASE_URL=postgresql+asyncpg://prasang:prasang@localhost:5433/prasang
ELASTICSEARCH_URL=http://localhost:9200
TEMPORAL_ADDRESS=localhost:7233
SUPERTOKENS_URI=http://localhost:3567
SUPERTOKENS_API_KEY=local-supertokens-key
API_DOMAIN=http://localhost:5173
WEBSITE_DOMAIN=http://localhost:5173
# Lets `Authorization: Bearer mock-artist|mock-planner|mock-new` act as demo users (local only; refused in production)
DEV_AUTH_HEADER=true

# Google sign-in (optional) — OAuth client from Google Cloud Console, redirect URI http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Photo/video uploads (optional) — S3 bucket + standard AWS credentials (AWS_PROFILE or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
AWS_REGION=ap-south-1
S3_BUCKET=
PUBLIC_MEDIA_BASE_URL=

# fake | razorpay
PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# console | msg91
NOTIFIER=console
