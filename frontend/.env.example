# API base path used by the browser. Keep /api/v1 in dev (Vite proxies it).
# In production set the absolute URL, e.g. https://api.prasang.in/api/v1
VITE_API_BASE_URL=/api/v1
# Where the Vite dev proxy sends /api: Mockoon (3001) or FastAPI (8000)
VITE_API_PROXY_TARGET=http://localhost:3001
# mock = Mockoon tokens (mock-artist / mock-planner / mock-new); supabase = real Google sign-in
VITE_AUTH_MODE=mock
