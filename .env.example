# Optional integrations for `docker compose up`. Copy to .env and fill in what you have — everything works without them.

# Google sign-in — OAuth client (Web) from Google Cloud Console.
# Authorised redirect URI: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube channel widgets for @handles (YouTube Data API v3 key). Channel URLs with /channel/UC… work without it.
YOUTUBE_API_KEY=

# Photo/video uploads — an S3 bucket (public read on artists/*, CORS allowing PUT from http://localhost:5173) + credentials.
S3_BUCKET=
PUBLIC_MEDIA_BASE_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payments — PhonePe Payment Links. Leave empty for local (a fake gateway: links are "paid" from the web app).
# Filling in the client id + secret switches PhonePe on. Keys: PhonePe Business dashboard → Developer Settings.
# Webhook (dashboard → Developer Settings → Webhook, SHA256 auth): URL https://<api-domain>/api/v1/subscriptions/webhook,
# events paylink.order.completed + paylink.order.failed, and the same username/password as below.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Email — any SMTP server; SendPulse: host smtp-pulse.com, port 465, login = your SendPulse account email, password from
# SendPulse → SMTP → Settings. EMAIL_SENDER must be a sender address verified in SendPulse. Empty SMTP_HOST = emails only logged.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=Prasang <hello@prasang.in>

# WhatsApp (+ optional SMS) — MSG91. MSG91_AUTH_KEY switches it on (MSG91 → Authkey).
# Without DLT, messages go on WhatsApp: connect a number in MSG91 → WhatsApp, create one Meta-approved template per message
# type and paste its *name* below. Print the exact template texts with:
#   docker compose exec api python -m app.cli msg91-templates
# A type without a template is skipped (logged); its email still goes out. OTP first — phone login depends on it.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_LANGUAGE=en
MSG91_WHATSAPP_TEMPLATE_OTP=
MSG91_WHATSAPP_TEMPLATE_LEAD=
MSG91_WHATSAPP_TEMPLATE_LEAD_LOCKED=
MSG91_WHATSAPP_TEMPLATE_WELCOME_ARTIST=
MSG91_WHATSAPP_TEMPLATE_WELCOME_PLANNER=
MSG91_WHATSAPP_TEMPLATE_TRIAL_ENDING=
MSG91_WHATSAPP_TEMPLATE_PAYMENT_LINK=
MSG91_WHATSAPP_TEMPLATE_RENEWAL_DUE=
MSG91_WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=
MSG91_WHATSAPP_TEMPLATE_PLAN_ENDED=
MSG91_WHATSAPP_TEMPLATE_MEDIA_REMOVAL=
MSG91_WHATSAPP_TEMPLATE_BOOKING_CHECK=
# SMS only if you register DLT later: a type with an SMS template id uses SMS instead of WhatsApp.
MSG91_SMS_TEMPLATE_OTP=
MSG91_SMS_TEMPLATE_LEAD=
MSG91_SMS_TEMPLATE_LEAD_LOCKED=
MSG91_SMS_TEMPLATE_WELCOME_ARTIST=
MSG91_SMS_TEMPLATE_WELCOME_PLANNER=
MSG91_SMS_TEMPLATE_TRIAL_ENDING=
MSG91_SMS_TEMPLATE_PAYMENT_LINK=
MSG91_SMS_TEMPLATE_RENEWAL_DUE=
MSG91_SMS_TEMPLATE_PAYMENT_RECEIVED=
MSG91_SMS_TEMPLATE_PLAN_ENDED=
MSG91_SMS_TEMPLATE_MEDIA_REMOVAL=
MSG91_SMS_TEMPLATE_BOOKING_CHECK=

# Google reviews on profiles — Google Places API (New) key. Without it the "From Google" block is hidden.
GOOGLE_PLACES_API_KEY=

# About / Contact pages — shown publicly (PhonePe's merchant review looks for them). Contact-form messages are emailed to
# SUPPORT_EMAIL (needs SMTP_* above for real email; otherwise they're stored and printed in `docker compose logs api`).
SUPPORT_EMAIL=
SUPPORT_PHONE=
BUSINESS_ADDRESS=
